---
import Header from "../components/Header.astro"
import FloatingButton from "../components/FloatingButton.astro"
import { getEntry } from "astro:content";

interface Props {
	title: string;
	description: string;
	// Nombre del servicio para el mensaje de WhatsApp; vacío en el inicio
	service?: string;
	jsonLd?: Record<string, unknown>[];
}

const homeImages = await getEntry("inicio", "inicio");
if (!homeImages) {
	throw new Error("Could not find inicio entry");
}

const { title, description, service, jsonLd = [] } = Astro.props;
const siteUrl = Astro.site?.href ?? "https://engeo.com.co/";
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const fullTitle = `${title} | ENGEO`;
// Logo de ENGEO para la vista previa al compartir el enlace
const ogImage = new URL("/og-image.png", siteUrl).href;

const organization = {
	"@context": "https://schema.org",
	"@type": "ProfessionalService",
	"@id": `${siteUrl}#organizacion`,
	name: "ENGEO Ingeniería y Geociencias S.A.S",
	alternateName: "ENGEO",
	url: siteUrl,
	logo: homeImages.data.logo,
	image: homeImages.data.inicioHeader[0],
	description: "Empresa colombiana de consultoría en ingeniería geotécnica, estudios de suelos, geología, aguas subterráneas, geomática, topografía, ingeniería estructural, hidráulica y vial, con laboratorio propio y flota de perforación.",
	telephone: ["+57 313 342 8939", "+57 313 379 0974", "+57 8 775 2275"],
	email: ["contacto@engeo.com.co", "engeoingenieria@gmail.com"],
	address: [
		{ "@type": "PostalAddress", addressLocality: "Bogotá", addressCountry: "CO" },
		{ "@type": "PostalAddress", addressLocality: "Sogamoso", addressRegion: "Boyacá", addressCountry: "CO" },
	],
	areaServed: ["Colombia", "Suramérica"],
	openingHoursSpecification: [
		{ "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], opens: "06:00", closes: "20:00" },
		{ "@type": "OpeningHoursSpecification", dayOfWeek: ["Saturday", "Sunday"], opens: "08:00", closes: "16:00" },
	],
	sameAs: ["https://www.facebook.com/ENGEO-Ingenieria-y-Geociencias-107641734268730"],
};
---

<!doctype html>
<html lang="es-CO">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/engeo-icon.png" />
		<link rel="apple-touch-icon" href="/engeo-icon.png">
		<meta name="msapplication-TileImage" content="/engeo-icon.png">
		<meta name="generator" content={Astro.generator} />
		<title>{ fullTitle }</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_CO" />
		<meta property="og:site_name" content="ENGEO Ingeniería y Geociencias" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Logo de ENGEO Ingeniería y Geociencias" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<script type="application/ld+json" set:html={JSON.stringify([organization, ...jsonLd])} />
	</head>
	<script is:inline src="https://cdn.jsdelivr.net/npm/flowbite@3.0.0/dist/flowbite.min.js" defer></script>
	<body>
		<Header />
		<slot />
		<FloatingButton service={service}/>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		font-family: Arial, Helvetica, sans-serif;
	}
</style>
